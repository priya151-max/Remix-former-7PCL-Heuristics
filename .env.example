# ---- Plain-language explanation writer (optional) --------------------------
# Without a key the site still works: an automatic explanation is assembled from
# the same retrieved knowledge passages.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_MAX_TOKENS=1800
# Send the three basic answers (sex, body site, elevation) to the writer? Images are never sent.
LLM_SHARE_METADATA=true

# ---- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# DEVICE=cuda        # default: auto-detect (cuda if available, else cpu)
MAX_UPLOAD_MB=15
JOB_TTL_MINUTES=60   # results and images are deleted from memory after this
MAX_QUEUE=8          # analyses allowed to wait at once before HTTP 429
